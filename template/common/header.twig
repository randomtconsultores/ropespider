    <script>
      document.querySelectorAll('.megamenu-item').forEach(function(item) {
        var toggle = item.querySelector('.megamenu-toggle');
        if (toggle) {
          toggle.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
              e.preventDefault();
              item.classList.toggle('active');
            }
          });
        }
      });

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.megamenu-item')) {
          document.querySelectorAll('.megamenu-item.active').forEach(function(item) {
            item.classList.remove('active');
          });
        }
      });

      document.addEventListener('DOMContentLoaded', function() {
        var megamenu = document.querySelector('.navbar-megamenu');
        if (!megamenu) { return; }
        var burger = document.createElement('button');
        burger.type = 'button';
        burger.innerHTML = '☰';
        burger.className = 'burger-menu';
        burger.setAttribute('aria-label', 'Menu');
        megamenu.parentElement.insertBefore(burger, megamenu);
        burger.addEventListener('click', function() {
          megamenu.classList.toggle('active');
        });
        function toggleBurger() {
          if (window.innerWidth <= 768) {
            burger.style.display = 'block';
          } else {
            burger.style.display = 'none';
            megamenu.classList.remove('active');
          }
        }
        toggleBurger();
        window.addEventListener('resize', toggleBurger);
      });
    </script>

