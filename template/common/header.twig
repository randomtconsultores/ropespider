              <ul class="megamenu-submenu">
                <li><a href="index.php?route=product/category&path=66">Ganchos</a></li>
                <li><a href="index.php?route=product/category&path=67">Argolas</a></li>
                <li><a href="index.php?route=product/category&path=68">Terminais</a></li>
              </ul>
            </li>

            <li class="megamenu-item">
              <a href="#" class="megamenu-toggle">Correntes</a>
              <ul class="megamenu-submenu">
                <li><a href="index.php?route=product/category&path=78">Correntes</a></li>
